# Guition JC4880P443C (ESP32-P4, engineering revision v1.3)
CONFIG_IDF_TARGET="esp32p4"

# Chip revision: same as the sdkconfig generated by the examples that run on this board.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# USB drive mode (P4 High-Speed USB)
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="P4 Recorder"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="P4 Recorder"
CONFIG_TINYUSB_DESC_MSC_STRING="Recordings"

# UI: runtime TTF fonts and screenshots for checking
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# LVGL uses system memory (with PSRAM) instead of the fixed 64 KB pool,
# which cannot hold TTF fonts or screenshots.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_SPIRAM_USE_MALLOC=y
# Plain malloc always goes to PSRAM. The UI makes thousands of small allocations
# that, in internal RAM, left Wi-Fi with only 25 KB of headroom.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Internal RAM reserved for those who need it: Wi-Fi (ESP-Hosted/SDIO), USB and DMA.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# QR code on the browser access screen
CONFIG_LV_USE_QRCODE=y
# Larger HTTP headers: browsers send many
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Long and accented file names on the card (names given to recordings)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# The USB component remounts the card at this path when the computer ejects it
# (it forgets the path given at the initial mount). Must match STORAGE_MOUNT_POINT.
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sdcard"

# Wi-Fi update: if the new firmware never confirms it booted fine,
# the next restart rolls back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
