# Guition JC4880P443C (ESP32-P4, revisão de engenharia v1.3)
CONFIG_IDF_TARGET="esp32p4"

# Revisão do chip: igual ao sdkconfig gerado pelos exemplos que rodam na placa.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Modo pendrive (USB High-Speed do P4)
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="P4 Recorder"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="P4 Recorder"
CONFIG_TINYUSB_DESC_MSC_STRING="Gravacoes"

# Interface: fontes TTF em tempo de execução e captura de tela para conferência
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# O LVGL usa a memória do sistema (com PSRAM) em vez do bloco fixo de 64 KB,
# que não comporta fontes TTF nem capturas de tela.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc comum vai sempre para a PSRAM. A interface faz milhares de alocações pequenas
# que, na RAM interna, deixavam o Wi-Fi com só 25 KB de folga.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Reserva de RAM interna para quem precisa dela: Wi-Fi (ESP-Hosted/SDIO), USB e DMA.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# QR code na tela de acesso pelo navegador
CONFIG_LV_USE_QRCODE=y
# Cabeçalhos HTTP maiores: navegadores mandam muitos
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Nomes de arquivo longos e com acento no cartão (nome dado às gravações)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# O componente USB remonta o cartão neste caminho quando o computador ejeta
# (ele esquece o caminho dado na montagem inicial). Tem de ser igual a STORAGE_MOUNT_POINT.
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sdcard"

# Atualização pelo Wi-Fi: se o firmware novo não chegar a confirmar que subiu bem,
# o próximo reinício volta para o anterior.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
